# =============================================================================
# Portal CPA — modelo de variáveis de ambiente.
# Copie para ".env" e preencha com os dados do seu projeto Supabase:
#   cp .env.example .env
# Valores em: Supabase Dashboard > Project Settings > API Keys / Database
# =============================================================================

# --- Supabase: API ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública: pode ir para o front-end (a proteção real é a RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta: SOMENTE no backend Flask. Ignora a RLS. Nunca expor.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Usada pelo Flask para validar os tokens JWT emitidos pelo Supabase Auth
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Supabase: conexão direta com o PostgreSQL ---
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Flask ---
FLASK_APP=app
FLASK_DEBUG=1
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-por-um-valor-aleatorio
